{
  "name": "PhytoScan Analyze",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "phytoscan-analyze",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-in",
      "name": "Webhook (analyze)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const hook = $('Webhook (analyze)').first().json;\n\nconst raw =\n  typeof hook.imageUrl === 'string' && hook.imageUrl.trim() !== '' ? hook.imageUrl\n  : (typeof hook.base64Image === 'string' && hook.base64Image.trim() !== '' ? hook.base64Image\n  : '');\nconst dataUrl = raw.startsWith('data:') ? raw : '';\n\n// A stable per-scan session id for the memory node. The app sends scanId for\n// chat; for scans we derive one from the image if absent so memory stays keyed\n// consistently per plant.\nconst scanId = typeof hook.scanId === 'string' && hook.scanId.trim() !== ''\n  ? hook.scanId\n  : 'scan-' + (typeof hook.imageUrl === 'string' ? hook.imageUrl : raw).slice(0, 64);\n\nreturn [{ json: {\n  ...hook,\n  scanId,\n  url: dataUrl ? '' : raw,\n  dataUrl,\n  imageUrl: raw\n} }];"
      },
      "id": "resolve-image",
      "name": "Resolve image",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        420
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.lat }}",
              "rightValue": "",
              "operator": {
                "type": "notEmpty"
              }
            },
            {
              "leftValue": "={{ $json.lng }}",
              "rightValue": "",
              "operator": {
                "type": "notEmpty"
              }
            }
          ]
        },
        "options": {}
      },
