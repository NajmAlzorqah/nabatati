    {
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\"identification\": {\"name\": \"\u0645\u0648\u0646\u0633\u062a\u064a\u0631\u0627\", \"scientific_name\": \"Monstera deliciosa\", \"confidence\": \"95%\"}, \"health_assessment\": {\"status\": \"\u0635\u062d\u064a\", \"diagnosis\": \"\u0627\u0644\u0646\u0628\u062a\u0629 \u0628\u0635\u062d\u0629 \u062c\u064a\u062f\u0629 \u0648\u0644\u0627 \u062a\u0648\u062c\u062f \u0645\u0634\u0627\u0643\u0644 \u0638\u0627\u0647\u0631\u0629\", \"needs_water\": true, \"needs_medicine\": false}, \"light_analysis\": {\"current_light\": \"\u0636\u0648\u0621 \u0633\u0627\u0637\u0639 \u063a\u064a\u0631 \u0645\u0628\u0627\u0634\u0631\", \"recommendation\": \"\u0636\u0639\u0647\u0627 \u0642\u0631\u0628 \u0646\u0627\u0641\u0630\u0629 \u062c\u0646\u0648\u0628\u064a\u0629 \u0645\u0639 \u0633\u062a\u0627\u0631\u0629 \u0634\u0641\u0627\u0641\u0629\"}, \"care_instructions\": {\"watering_frequency\": \"\u0645\u0631\u0629 \u0641\u064a \u0627\u0644\u0623\u0633\u0628\u0648\u0639\", \"soil_type\": \"\u062e\u0644\u0637\u0629 \u062a\u0631\u0628\u0629 \u062c\u064a\u062f\u0629 \u0627\u0644\u062a\u0635\u0631\u064a\u0641\", \"toxicity\": \"\u0633\u0627\u0645 \u0644\u0644\u062d\u064a\u0648\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u0644\u064a\u0641\u0629\"}, \"environmental_impact\": \"\u0646\u0628\u062a\u0629 \u0645\u0646\u0632\u0644\u064a\u0629 \u062a\u0646\u0642\u0651\u064a \u0627\u0644\u0647\u0648\u0627\u0621\", \"fun_fact\": \"\u0627\u0644\u0623\u0648\u0631\u0627\u0642 \u0627\u0644\u0645\u0634\u0642\u0651\u0642\u0629 \u062a\u064f\u0633\u0645\u0649 fenestrations.\"}"
      },
      "id": "output-parser",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1700,
        700
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.all()[0].json;\nconst agentCtx = $('Prepare agent input').first().json;\nconst wrapped = item.output || item.json || item;\nconst parsed = (wrapped && wrapped.output && typeof wrapped.output === 'object') ? wrapped.output : wrapped;\n\nreturn [{ json: {\n  analysis: parsed,\n  imageUrl: agentCtx.imageUrl || '',\n  temp: agentCtx.temp,\n  humidity: agentCtx.humidity,\n  scanId: agentCtx.scanId || '',\n  created_at: new Date().toISOString()\n} }];"
      },
      "id": "clean-result",
      "name": "Clean result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ analysis: $('Clean result').first().json.analysis, temp: $('Clean result').first().json.temp, humidity: $('Clean result').first().json.humidity }) }}"
      },
