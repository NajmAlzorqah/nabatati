          "name": "OpenWeatherMap API key"
        }
      }
    },
    {
      "parameters": {
        "mode": "append",
        "options": {}
      },
      "id": "merge",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [
        1020,
        140
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Resolve image').first().json.url }}",
        "sendBody": false,
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data",
              "neverError": true
            }
          }
        }
      },
      "id": "fetch-image",
      "name": "Fetch image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        -60
      ]
    },
    {
      "parameters": {
        "jsCode": "const resolved = $('Resolve image').first().json;\nconst prepared = $('Prepare agent input').first().json;\n\n// If we already fetched the image as binary via the HTTP node, keep it.\nconst input = $input.all()[0];\nconst hasBinary = !!(input && input.binary && Object.keys(input.binary).length > 0);\n\nif (hasBinary) {\n  return [{ json: prepared, binary: input.binary }];\n}\n\n// Otherwise the payload was a base64 data: URL. Convert it to a binary image\n// so the AI Agent's passthroughBinaryImages can forward it to the model.\nif (resolved.dataUrl) {\n  const match = /^data:([^;]+);base64,(.+)$/.exec(resolved.dataUrl);\n  if (match) {\n    const mime = match[1] || 'image/jpeg';\n    const b64 = match[2];\n    return [{ json: prepared, binary: { data: {\n      data: b64,\n      mimeType: mime,\n      fileName: prepared.imageUrl.split('/').pop() || 'plant.jpg'\n    } } }];\n  }\n}\n\nthrow new Error('No image received. imageUrl: ' + (resolved.imageUrl || '(none)') + ' | base64Image: ' + (resolved.dataUrl ? '(data URL)' : '(none)'));"
      },
      "id": "encode-image",
      "name": "Prepare binary image",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        60
      ]
    },
    {
      "parameters": {
        "jsCode": "const source = $('Merge').first().json;\nconst resolved = $('Resolve image').first().json;\n\nconst hasWeather = source && source.main &&\n  (source.main.temp !== undefined || source.main.humidity !== undefined);\nconst temp = hasWeather ? source.main.temp : 'N/A';\nconst humidity = hasWeather ? source.main.humidity : 'N/A';\n\nconst chatInput =\n  '\u0642\u0645 \u0628\u062a\u062d\u0644\u064a\u0644 \u0635\u0648\u0631\u0629 \u0627\u0644\u0646\u0628\u0627\u062a \u0647\u0630\u0647. \u062d\u062f\u0651\u062f \u0627\u0644\u0646\u0648\u0639 \u0648\u0642\u062f\u0651\u0645 \u062a\u0642\u064a\u064a\u0645\u064b\u0627 \u0644\u0635\u062d\u0651\u062a\u0647 \u0648\u0641\u0642 \u0627\u0644\u0628\u0646\u064a\u0629 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629. ' +\n  'Environmental context \u2014 Temperature: ' + temp + '\u00b0\u0645\u060c \u0627\u0644\u0631\u0637\u0648\u0628\u0629: ' + humidity + '%. ' +\n  '\u0625\u0630\u0627 \u0644\u0645 \u062a\u062a\u0648\u0641\u0651\u0631 \u0627\u0644\u062d\u0631\u0627\u0631\u0629/\u0627\u0644\u0631\u0637\u0648\u0628\u0629\u060c \u0627\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0627\u0644\u0635\u0648\u0631\u0629 \u0648\u062d\u062f\u0647\u0627 \u0648\u0627\u062c\u0639\u0644 environmental_impact \u062c\u0645\u0644\u0629 \u0639\u0627\u0645\u0629.';\n\nreturn [{ json: {\n  chatInput,\n  temp,\n  humidity,\n  scanId: resolved.scanId,\n  imageUrl: resolved.imageUrl,\n  lat: resolved.lat,\n  lng: resolved.lng\n} }];"
      },
      "id": "prepare-agent",
      "name": "Prepare agent input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        200
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.chatInput }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "\u0623\u0646\u062a PhytoScan AI\u060c \u0639\u0627\u0644\u0645 \u0646\u0628\u0627\u062a\u0627\u062a \u0645\u0646 \u0627\u0644\u0637\u0631\u0627\u0632 \u0627\u0644\u0623\u0648\u0644. \u062a\u062d\u0644\u0651\u0644 \u0635\u0648\u0631 \u0627\u0644\u0646\u0628\u0627\u062a\u0627\u062a \u0648\u062a\u0639\u064a\u062f \u062a\u0642\u064a\u064a\u0645\u064b\u0627 \u0645\u0646\u0638\u0645\u064b\u0627 \u0644\u0644\u0635\u062d\u0651\u0629 \u0648\u0627\u0644\u0646\u0648\u0639\u060c \u062c\u0645\u064a\u0639 \u0627\u0644\u0646\u0635\u0648\u0635 \u0628\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0641\u0635\u062d\u0649. \u0627\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0635\u0648\u0631\u0629 (\u0648\u0623\u064a \u0633\u064a\u0627\u0642 \u0628\u064a\u0626\u064a \u0645\u062a\u0627\u062d) \u0644\u0645\u0644\u0621 \u0643\u0644 \u062d\u0642\u0644. \u0623\u0639\u0650\u062f \u0628\u064a\u0627\u0646\u0627\u062a JSON \u0635\u0627\u0644\u062d\u0629 \u0641\u0642\u0637 \u062f\u0627\u062e\u0644 \u0643\u0627\u0626\u0646 \"output\" (\u0645\u062b\u0627\u0644: {\"output\": { \"identification\": {...}, \"health_assessment\": {...}, ... }}) \u2014 \u0636\u0639 \u0627\u0644\u062a\u0642\u064a\u064a\u0645 \u0643\u0627\u0645\u0644\u064b\u0627 (identification\u060c health_assessment\u060c light_analysis\u060c care_instructions\u060c environmental_impact\u060c fun_fact) \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u0641\u062a\u0627\u062d \"output\" \u0627\u0644\u0645\u0637\u0644\u0648\u0628. \u0628\u0644\u0627 Markdown \u0623\u0648 \u0641\u0648\u0627\u0635\u0644 \u0623\u0643\u0648\u0627\u062f \u0623\u0648 \u0645\u0642\u062f\u0645\u0627\u062a \u0623\u0648 \u0646\u0635\u0648\u0635 \u0632\u0627\u0626\u062f\u0629. \u064a\u062c\u0628 \u0623\u0646 \u062a\u0643\u0648\u0646 confidence \u0633\u0644\u0633\u0644\u0629 \u062a\u0646\u062a\u0647\u064a \u0628\u0640 '%'. \u064a\u062c\u0628 \u0623\u0646 \u062a\u0643\u0648\u0646 status \u0628\u0627\u0644\u0636\u0628\u0637 \u0648\u0627\u062d\u062f\u0629 \u0645\u0646: \u00ab\u0635\u062d\u064a\u00bb \u0623\u0648 \u00ab\u0625\u0646\u0630\u0627\u0631\u00bb \u0623\u0648 \u00ab\u062d\u0631\u062c\u00bb. \u064a\u062c\u0628 \u0623\u0646 \u062a\u0643\u0648\u0646 toxicity \u0628\u0627\u0644\u0636\u0628\u0637 \u0648\u0627\u062d\u062f\u0629 \u0645\u0646: \u00ab\u0622\u0645\u0646 \u0644\u0644\u062d\u064a\u0648\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u0644\u064a\u0641\u0629\u00bb \u0623\u0648 \u00ab\u0633\u0627\u0645 \u0644\u0644\u062d\u064a\u0648\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u0644\u064a\u0641\u0629\u00bb. \u064a\u062c\u0628 \u0623\u0646 \u062a\u0643\u0648\u0646\u0627 needs_water \u0648 needs_medicine \u0642\u064a\u0645\u062a\u064a\u0646 \u0645\u0646\u0637\u0642\u064a\u062a\u064a\u0646 JSON.",
          "passthroughBinaryImages": true
        }
      },
