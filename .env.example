# ─────────────────────────────────────────────────────────────
# نباتاتي (nabatati) — example environment
# Copy to `.env.local` and fill in your own values:
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# n8n webhooks. These are called from the browser, so they use the
# NEXT_PUBLIC_ prefix (Next.js only exposes those to client code).
# Leave them blank and the app surfaces a clear "not configured" error
# instead of returning placeholder data.
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://your-n8n.example.com/webhook/nabatati-analyze
NEXT_PUBLIC_N8N_CHAT_WEBHOOK_URL=https://your-n8n.example.com/webhook/nabatati-chat

# Supabase (optional). Without these the app falls back to localStorage,
# which is fine for trying it out but does not sync across devices.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Storage bucket that scan photos are uploaded to. Must match the public
# bucket you create in Supabase. See docs/supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_BUCKET=plant-photos
